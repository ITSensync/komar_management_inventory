# Docker Compose ports exposed on the development machine.
API_PORT=3000
WEB_PORT=3001

# MySQL service and application credentials. Replace these before any shared deployment.
DB_NAME=rfid_inventory
DB_USER=rfid_inventory_app
DB_PASSWORD=change_this_application_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Used by the API for direct browser/mobile access. The web app itself proxies /api.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Used when running the Next.js app outside Docker. Docker supplies http://api:3000 at build time.
INTERNAL_API_BASE_URL=http://localhost:3000
