{
  "name": "komar-management-inventory",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "pnpm --dir apps/web dev",
    "test:api": "npm --prefix apps/api test",
    "test:web": "pnpm --dir apps/web test",
    "lint:web": "pnpm --dir apps/web lint",
    "check:api": "node --check apps/api/server.js",
    "build:web": "pnpm --dir apps/web build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:config": "docker compose config"
  }
}
